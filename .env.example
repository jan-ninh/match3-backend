# Copy to ignored .env; use your own isolated database for development. Never commit credentials.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=match3_dev
CLIENT_BASE_URL=http://localhost:5173
# Replace placeholder with >=32 random bytes; production requires it.
ACCESS_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
SALT_ROUNDS=10
# Production defaults: Secure=true, SameSite=none. Prefer lax if deployment is same-site.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Set explicitly for the known reverse proxy topology; default trusts no proxy.
TRUST_PROXY_HOPS=0
